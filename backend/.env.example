# Environment Profile
NODE_ENV=development
PORT=5000

# PostgreSQL (Neon/Local)
DATABASE_URL="postgresql://user:password@localhost:5432/sarkari_mitra?schema=public"

# Elasticsearch Configuration
ELASTICSEARCH_NODE="http://localhost:9200"
# For production (Elastic Cloud):
# ELASTICSEARCH_CLOUD_ID="deployment-name:xyz"
# ELASTICSEARCH_API_KEY="your-api-key"

SCHEMES_INDEX_VERSION="1"

# Qdrant Configuration
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Gemini AI Configuration
GEMINI_API_KEY="your_gemini_api_key"

# JWT Authentication
JWT_SECRET="super-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Scheduler
CRON_SCHEDULE="0 0 * * *"
SYNC_SECRET="super-secret-sync-key-change-in-production"
